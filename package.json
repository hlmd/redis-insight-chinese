{
  "name": "redis-insight-chinese",
  "version": "0.3.1",
  "description": "Redis Insight 桌面端非官方中文本地化工具(简体中文 / 繁體中文,运行时注入,跨平台 CLI)。与 Redis Ltd. 无关。",
  "type": "module",
  "bin": {
    "redis-insight-chinese": "redis-insight-chinese.js"
  },
  "files": [
    "redis-insight-chinese.js",
    "src/",
    "locales/"
  ],
  "scripts": {
    "apply": "node redis-insight-chinese.js apply",
    "restore": "node redis-insight-chinese.js restore",
    "extract": "node redis-insight-chinese.js extract",
    "test": "node --test",
    "build:data": "node scripts/build-data.js",
    "build:win": "node scripts/build-bin.js bun-windows-x64 dist/redis-insight-chinese-win-x64.exe",
    "build:mac-arm": "node scripts/build-bin.js bun-darwin-arm64 dist/redis-insight-chinese-macos-arm64",
    "build:mac-x64": "node scripts/build-bin.js bun-darwin-x64 dist/redis-insight-chinese-macos-x64",
    "build:linux": "node scripts/build-bin.js bun-linux-x64 dist/redis-insight-chinese-linux-x64",
    "build:all": "npm run build:win && npm run build:mac-arm && npm run build:mac-x64 && npm run build:linux && npm run build:linux-arm64",
    "build:linux-arm64": "node scripts/build-bin.js bun-linux-arm64 dist/redis-insight-chinese-linux-arm64",
    "build:update": "node scripts/build-update.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlmd/redis-insight-chinese.git"
  },
  "homepage": "https://github.com/hlmd/redis-insight-chinese#readme",
  "bugs": {
    "url": "https://github.com/hlmd/redis-insight-chinese/issues"
  },
  "dependencies": {
    "@electron/asar": "^4.3.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "redis",
    "redis-insight",
    "chinese",
    "localization",
    "zh-CN",
    "zh-TW"
  ]
}
